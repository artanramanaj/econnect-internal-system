# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/EMS?schema=public"

# --- auth / session ---
# Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development

# --- bootstrap super admin (used by prisma/seed.ts; dev only) ---
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
