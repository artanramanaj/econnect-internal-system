// ---------- core (shared) ----------

/// VAT rates by validity period. A rate change is a new row with a new
/// validFrom, so a document can still show the rate that applied on its date.
/// Items store the `code`, not a row id, which is why nothing has a foreign
/// key into this table.
model VatRate {
  id        Int       @id @default(autoincrement())
  code      String    @db.VarChar(20) // STANDARD, REDUCED, ZERO
  name      String    @db.VarChar(60)
  rate      Decimal   @db.Decimal(5, 2) // 18.00
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  // This constraint's index also serves lookups by code; a separate
  // @@index([code, validFrom]) would be an exact duplicate of it.
  @@unique([code, validFrom])
  @@map("vat_rates")
}

/// Gap-free document numbers (a legal requirement for quotes). The row is
/// locked with SELECT ... FOR UPDATE inside the transaction that creates the
/// document, so a rollback hands the number back. A Postgres sequence would
/// not: it skips numbers on rollback.
model DocumentSequence {
  id         Int    @id @default(autoincrement())
  docType    String @map("doc_type") @db.VarChar(20) // QUOTE, PARTNER
  year       Int // 0 for a sequence that never restarts
  prefix     String @db.VarChar(10) // EC, P
  nextNumber Int    @default(1) @map("next_number")

  @@unique([docType, year])
  @@map("document_sequences")
}

/// Business settings that must not be hardcoded, e.g. the markup below which
/// a quote needs approval. Values are strings; the reader parses them.
model AppSetting {
  key       String   @id @db.VarChar(60) // quote.min_markup_pct
  value     String   @db.VarChar(255)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}
