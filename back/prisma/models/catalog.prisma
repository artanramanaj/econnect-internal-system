// ---------- catalogue ----------

/// Where an item's master data lives. PRODATA rows are owned by the nightly
/// sync: the fields in SYNC_OWNED_FIELDS (constants/catalog.constants.ts) are
/// read-only in the app. LOCAL rows are created and edited in the app.
enum ItemSource {
  PRODATA
  LOCAL
}

enum ItemType {
  PRODUCT
  SERVICE
}

/// Managed on the Products screen (add / rename / guarded delete). The ProData
/// sync will upsert names it meets, so a sync never blocks on a missing row.
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  items Item[]

  @@map("categories")
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  items Item[]

  @@map("brands")
}

model Item {
  id           Int        @id @default(autoincrement())
  sku          String     @unique @db.VarChar(60)
  source       ItemSource @default(PRODATA)
  type         ItemType   @default(PRODUCT)
  description  String     @db.VarChar(255)
  categoryId   Int?       @map("category_id")
  brandId      Int?       @map("brand_id")
  baseUnitCode String     @map("base_unit_code") @db.VarChar(10)
  costPrice    Decimal    @default(0) @map("cost_price") @db.Decimal(12, 4)
  vatCode      String     @map("vat_code") @db.VarChar(20)
  isArchived   Boolean    @default(false) @map("is_archived")
  sourceId     Int?       @unique @map("source_id") // ProData tblArtikujt.ID
  barcode      String?    @db.VarChar(60)
  manufacturer String?    @db.VarChar(80) // Prodhuesi
  brochureFile String?    @map("brochure_file") @db.VarChar(100) // server-generated name under uploads/brochures
  brochureName String?    @map("brochure_name") @db.VarChar(255) // the name the PDF was uploaded with
  brochureSize Int?       @map("brochure_size") // bytes
  lastSyncedAt DateTime?  @map("last_synced_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  // Restrict: a category or brand still in use cannot be deleted. The API
  // checks first and answers 409 (like positions.stillHeld); this is the backstop.
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand       Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  baseUnit    Unit              @relation(fields: [baseUnitCode], references: [code])
  units       ItemUnit[]
  costHistory ItemCostHistory[]
  quoteLines  QuoteLine[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isArchived])
  @@index([type])
  // Trigram indexes for the search box, which runs ILIKE '%term%' over sku and
  // description (pg_trgm is created in the add_catalog migration). Postgres
  // uses them for that OR only when every branch is indexable — the category
  // branch is pre-resolved to `category_id IN (...)` on the btree above.
  // Declared here rather than only in SQL: an index the schema does not know
  // about gets a DROP INDEX in the next `migrate dev`.
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "items_sku_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "items_description_trgm")
  @@map("items")
}

model Unit {
  code String @id @db.VarChar(10) // pcs, m, box, hr
  name String @db.VarChar(50)

  items     Item[]
  itemUnits ItemUnit[]

  @@map("units")
}

/// An alternative unit an item can be quoted in, e.g. a box of 10 pcs. The
/// base unit itself is never listed here.
model ItemUnit {
  id       Int     @id @default(autoincrement())
  itemId   Int     @map("item_id")
  unitCode String  @map("unit_code") @db.VarChar(10)
  factor   Decimal @db.Decimal(12, 4) // how many base units in one of these

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitCode], references: [code])

  @@unique([itemId, unitCode])
  @@map("item_units")
}

model ItemCostHistory {
  id        Int        @id @default(autoincrement())
  itemId    Int        @map("item_id")
  oldCost   Decimal?   @map("old_cost") @db.Decimal(12, 4) // null on an item's first entry
  newCost   Decimal    @map("new_cost") @db.Decimal(12, 4)
  source    ItemSource
  syncRunId Int?       @map("sync_run_id")
  changedBy Int?       @map("changed_by") // user id; null when from the sync
  changedAt DateTime   @default(now()) @map("changed_at")

  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  syncRun SyncRun? @relation(fields: [syncRunId], references: [id])

  @@index([itemId, changedAt])
  @@map("item_cost_history")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model SyncRun {
  id            Int        @id @default(autoincrement())
  startedAt     DateTime   @default(now()) @map("started_at")
  finishedAt    DateTime?  @map("finished_at")
  status        SyncStatus @default(RUNNING)
  attempt       Int        @default(1)
  createdCount  Int        @default(0) @map("created_count")
  updatedCount  Int        @default(0) @map("updated_count")
  archivedCount Int        @default(0) @map("archived_count")
  errorMessage  String?    @map("error_message")

  costChanges ItemCostHistory[]

  @@index([startedAt])
  @@map("sync_runs")
}
