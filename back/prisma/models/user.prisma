// ---------- identity ----------

model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique @db.VarChar(50)
  email       String     @unique @db.VarChar(120)
  password    String     @db.VarChar(255)
  mfaSecret   String?    @map("mfa_secret") @db.VarChar(255)
  locale      String     @default("sq") @db.VarChar(5)
  status      UserStatus @default(PENDING)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")

  employeeId    Int?           @unique @map("employee_id")
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

enum UserStatus {
  PENDING // registered, waiting for admin activation
  ACTIVE
  SUSPENDED
}

model Employee {
  id           Int      @id @default(autoincrement())
  number       String?  @unique @db.VarChar(20)
  firstName    String   @map("first_name") @db.VarChar(50)
  lastName     String   @map("last_name") @db.VarChar(50)
  positionId   Int?     @map("position_id")
  phone        String?  @db.VarChar(30)
  isFieldStaff Boolean  @default(false) @map("is_field_staff")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user      User?
  position  Position?          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  costRates EmployeeCostRate[]

  @@index([positionId])
  @@map("employees")
}

model EmployeeCostRate {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  validFrom  DateTime @map("valid_from") @db.Date
  hourlyCost Decimal  @map("hourly_cost") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, validFrom])
  @@map("employee_cost_rates")
}

/// Job title, separate from the group/role: the role decides what you may do,
/// the position is what you are called. Retired via isActive rather than
/// deleted, so people who held it keep it.
model Position {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("positions")
}

// ---------- access control ----------

model Role {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50) // super_admin, admin, pm, tl, technician
  name      String   @db.VarChar(80)
  isSystem  Boolean  @default(false) @map("is_system") // blocks deletion of the 5 core roles
  createdAt DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(80) // quote.approve, wo.assign, plan.approve
  module      String  @db.VarChar(30) // quoting, projects, wo, core...
  description String? @db.VarChar(200)

  roles RolePermission[]

  @@map("permissions")
}

enum PermissionScope {
  ALL // "Full" / "View" in the chapter 13 matrix
  OWN // created by, or assigned to, this user
}

model RolePermission {
  roleId       Int             @map("role_id")
  permissionId Int             @map("permission_id")
  scope        PermissionScope @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy Int?     @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Postgres does not index foreign keys automatically, and every issue/prune
  // filters by userId.
  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}
